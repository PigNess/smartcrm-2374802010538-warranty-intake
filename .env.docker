# ==========================================
# Cấu hình Môi trường Docker Compose
# Dự án: Smart CRM - Tiếp nhận bảo hành
# ==========================================

# Cấu hình Cơ sở dữ liệu PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=smartcrm
DB_PASSWORD=smartcrm_secret

# Cấu hình Backend Node.js / Express
BACKEND_PORT=3000
SECRET_KEY=smartcrm_jwt_secret_key_2026

# Cấu hình Frontend React / Vite
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
