        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor LightCyan\n  BorderColor DarkCyan\n}\n\nactor \&quot;Nhân viên tiếp nhận\&quot; as NV\nactor \&quot;Quản lý trung tâm\&quot; as QL\nactor \&quot;Hệ thống tính toán\\n(System Timer)\&quot; as SYS\n\nrectangle \&quot;Hệ thống Smart CRM - Phân hệ L2\&quot; {\n  usecase \&quot;UC01: Tra cứu hồ sơ khách hàng\&quot; as UC1\n  usecase \&quot;UC02: Tạo hồ sơ KH mới\&quot; as UC2\n  usecase \&quot;UC03: Ghi nhận thông tin thiết bị\&quot; as UC3\n  usecase \&quot;UC04: Lập phiếu yêu cầu bảo hành\&quot; as UC4\n  usecase \&quot;UC05: Cập nhật trạng thái phiếu\&quot; as UC5\n  \n  usecase \&quot;UC06: Phê duyệt phiếu ngoại lệ\&quot; as UC6\n  usecase \&quot;UC07: Giám sát tiến độ phiếu (SLA)\&quot; as UC7\n  usecase \&quot;UC08: Cập nhật danh mục nhóm sự cố\&quot; as UC8\n  usecase \&quot;UC09: Xem chi tiết bảo mật KH\&quot; as UC9\n}\n\n&#39; Kết nối của Nhân viên\nNV -- UC1\nNV -- UC3\nNV -- UC4\nNV -- UC5\n\n&#39; Kết nối của Quản lý\nQL -- UC6\nQL -- UC7\nQL -- UC8\nQL -- UC9\n\n&#39; Kết nối của Actor Hệ thống\nUC4 -- SYS\nUC7 -- SYS\n\n&#39; QUAN HỆ INCLUDE VÀ EXTEND\nUC4 .down.&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC2 .up.&gt; UC1 : &lt;&lt;extend&gt;&gt;\n\n&#39; GHI CHÚ CHO CÁC USE CASE\nnote bottom of UC2\n  Chỉ kích hoạt tạo mới\n  nếu tra cứu KH không thấy\nend note\n\nnote top of UC4\n  Bao gồm tự động tính SLA\n  (bỏ qua ngày Chủ Nhật)\nend note\n\n&#39; CHÚ THÍCH TỔNG QUAN\nnote bottom of NV\n  Chú thích sơ đồ:\n  - Đường liền: Tương tác trực tiếp.\n  - &lt;&lt;include&gt;&gt;: Bắt buộc phải thực hiện.\n  - &lt;&lt;extend&gt;&gt;: Luồng ngoại lệ/Tùy chọn.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vD4q7tlCEFc0CiFJkvMg-31">
