        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam linetype ortho\nskinparam defaultFontName Arial\nskinparam class {\n    BackgroundColor White\n    BorderColor Black\n    ArrowColor Black\n}\n\nentity \&quot;customer\&quot; as cus {\n  * customer_id : SERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * full_name : VARCHAR(100)\n  * phone : VARCHAR(10) &lt;&lt;UNIQUE&gt;&gt;\n  created_at : TIMESTAMP\n}\n\nentity \&quot;device\&quot; as dev {\n  * device_id : SERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * customer_id : INT &lt;&lt;FK&gt;&gt;\n  * serial_imei : VARCHAR(50) &lt;&lt;UNIQUE&gt;&gt;\n  purchase_date : DATE\n  warranty_months : INT\n}\n\nentity \&quot;issue_category\&quot; as cat {\n  * category_id : SERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * category_name : VARCHAR(100)\n  is_active : BOOLEAN\n}\n\nentity \&quot;ticket\&quot; as tkt {\n  * ticket_id : SERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * device_id : INT &lt;&lt;FK&gt;&gt;\n  * category_id : INT &lt;&lt;FK&gt;&gt;\n  * priority : VARCHAR(20)\n  sla_deadline : TIMESTAMP\n  status : VARCHAR(50)\n  created_at : TIMESTAMP\n}\n\nentity \&quot;ticket_status_log\&quot; as log {\n  * log_id : SERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * ticket_id : INT &lt;&lt;FK&gt;&gt;\n  old_status : VARCHAR(50)\n  * new_status : VARCHAR(50)\n  changed_at : TIMESTAMP\n}\n\n&#39; Nối quan hệ 1-N (Một - Nhiều) giữa các bảng\ncus ||--o{ dev\ndev ||--o{ tkt\ncat ||--o{ tkt\ntkt ||--o{ log\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yiMpThenSnQa5bebms4L-1">
